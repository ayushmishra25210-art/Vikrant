{
  "info": {
    "name": "e-Prahari - Cryptographic Attribution & Provenance API",
    "description": "Postman collection for the SIH prototype: Cryptographic Attribution and Immutable Decryption Provenance for Multi-Recipient Encrypted Document Distribution.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5050/api" },
    { "key": "adminToken", "value": "" },
    { "key": "recipientToken", "value": "" },
    { "key": "documentId", "value": "" },
    { "key": "recipientId", "value": "" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login (Admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const data = pm.response.json();",
                  "pm.collectionVariables.set('adminToken', data.token);",
                  "pm.test('Login succeeded', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"employeeId\": \"EMP001\",\n  \"password\": \"Admin@123\"\n}" },
            "url": "{{baseUrl}}/auth/login"
          }
        },
        {
          "name": "Login (Recipient)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const data = pm.response.json();",
                  "pm.collectionVariables.set('recipientToken', data.token);",
                  "pm.collectionVariables.set('recipientId', data.user.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"employeeId\": \"EMP101\",\n  \"password\": \"Recipient@123\"\n}" },
            "url": "{{baseUrl}}/auth/login"
          }
        },
        {
          "name": "Get Current User",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": "{{baseUrl}}/auth/me"
          }
        }
      ]
    },
    {
      "name": "Documents",
      "item": [
        {
          "name": "Upload Document (Admin)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "file", "type": "file", "src": "" },
                { "key": "classification", "value": "CONFIDENTIAL", "type": "text" },
                { "key": "description", "value": "Sample upload via Postman", "type": "text" },
                { "key": "recipients", "value": "[\"EMP101\",\"EMP102\"]", "type": "text" }
              ]
            },
            "url": "{{baseUrl}}/documents/upload"
          }
        },
        {
          "name": "List Documents",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": "{{baseUrl}}/documents"
          }
        },
        {
          "name": "Get Document",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": "{{baseUrl}}/documents/{{documentId}}"
          }
        },
        {
          "name": "Assign Recipients (Admin)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"recipientIds\": [\"EMP103\"]\n}" },
            "url": "{{baseUrl}}/documents/{{documentId}}/assign"
          }
        },
        {
          "name": "Decrypt Document (Recipient)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{recipientToken}}" },
              { "key": "X-Device-Id", "value": "postman-test-device" }
            ],
            "url": "{{baseUrl}}/documents/{{documentId}}/decrypt"
          }
        },
        {
          "name": "Get Document Provenance",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": "{{baseUrl}}/documents/{{documentId}}/provenance"
          }
        }
      ]
    },
    {
      "name": "Ledger",
      "item": [
        {
          "name": "Get Ledger (paginated, search)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/ledger?page=1&limit=25",
              "host": ["{{baseUrl}}"],
              "path": ["ledger"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "25" },
                { "key": "search", "value": "", "disabled": true },
                { "key": "recipientId", "value": "", "disabled": true },
                { "key": "from", "value": "", "disabled": true },
                { "key": "to", "value": "", "disabled": true }
              ]
            }
          }
        },
        {
          "name": "Verify Ledger Chain Integrity",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": "{{baseUrl}}/ledger/verify"
          }
        }
      ]
    },
    {
      "name": "Leak Verification",
      "item": [
        {
          "name": "Verify Leaked Document (Admin)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "body": {
              "mode": "formdata",
              "formdata": [{ "key": "file", "type": "file", "src": "" }]
            },
            "url": "{{baseUrl}}/verify-leak"
          }
        }
      ]
    },
    {
      "name": "Recipients & History",
      "item": [
        {
          "name": "List Recipients",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": "{{baseUrl}}/recipient"
          }
        },
        {
          "name": "Get Recipient History",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": "{{baseUrl}}/recipient/{{recipientId}}/history"
          }
        }
      ]
    },
    {
      "name": "Dashboard",
      "item": [
        {
          "name": "Admin Stats",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": "{{baseUrl}}/dashboard/admin"
          }
        },
        {
          "name": "Recipient Stats",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{recipientToken}}" }],
            "url": "{{baseUrl}}/dashboard/recipient"
          }
        }
      ]
    },
    {
      "name": "Health",
      "item": [
        {
          "name": "Health Check",
          "request": { "method": "GET", "url": "{{baseUrl}}/health" }
        }
      ]
    }
  ]
}
