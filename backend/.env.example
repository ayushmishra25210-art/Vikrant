PORT=5050
NODE_ENV=development

# PostgreSQL connection. Either set DATABASE_URL directly, or leave it unset
# and use the discrete PG* parts below (handy when a password has characters
# that are awkward to URL-encode). With nothing set at all, it defaults to
# postgres://<your-OS-username>@127.0.0.1:5432/sih_crypto_provenance — the
# standard Homebrew/apt local install with no password. Create the database
# first with: createdb sih_crypto_provenance
DATABASE_URL=postgres://postgres@127.0.0.1:5432/sih_crypto_provenance
# PGHOST=127.0.0.1
# PGPORT=5432
# PGUSER=postgres
# PGPASSWORD=
# PGDATABASE=sih_crypto_provenance

# JWT
JWT_SECRET=change_this_to_a_long_random_secret_in_production
JWT_EXPIRES_IN=8h

# Ledger genesis seed (used to compute the first block's previousHash)
LEDGER_GENESIS_SEED=SIH-CRYPTO-PROVENANCE-GENESIS-BLOCK

# Server-side ledger signing key passphrase (demo only — in production use HSM/KMS)
LEDGER_SIGNING_PASSPHRASE=demo-ledger-signing-passphrase-2026

# Frontend origin for CORS — optional. Any http://localhost:<port> or
# http://127.0.0.1:<port> origin is already allowed by default (see app.js),
# so this only matters for a real, non-local deployment.
FRONTEND_ORIGIN=http://localhost:5173
